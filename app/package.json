{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:client": "tsc -b && vite build --mode client && node scripts/package-client-release.mjs",
    "build:vercel": "node scripts/prepare-vercel-content.mjs && tsc -b && vite build --mode client && node scripts/prune-dist-content.mjs",
    "build:pages": "tsc -b && vite build --mode client --base /velbee-visuals-demo/ && node scripts/sync-github-pages.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "render:orbit": "node scripts/render-orbit-360.mjs",
    "render:orbit-360": "node scripts/render-orbit-360.mjs",
    "render:orbit-bands": "node scripts/render-orbit-bands.mjs",
    "render:orbit-ai": "python ../content/scripts/generate_orbit_from_orbit8.py",
    "render:orbit-procedural": "node scripts/render-orbit.mjs",
    "render:plate-panos": "node scripts/render-plate-panos.mjs",
    "render:simple-plate": "node scripts/render-simple-plate.mjs",
    "sync:plate-match": "node scripts/sync-plate-match.mjs",
    "render:floor-plan": "node scripts/render-floor-plan.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "playwright": "^1.56.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
