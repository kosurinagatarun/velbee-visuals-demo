# Serve on tenant host: https://{workspace}.velbee.com/showcase/{project}/
VITE_BASE_PATH=/showcase/

# Local dev when not using *.velbee.com in /etc/hosts
# VITE_WORKSPACE_SLUG=acme
# VITE_PROJECT_SLUG=gachibowli

# --- Cloudflare R2 (production images + JSON) ---
# Public bucket via custom domain (recommended):
# VITE_R2_PUBLIC_BASE=https://cdn.velbee.com/visuals/{workspace}/{project}
# Same as VITE_CONTENT_BASE (either env works; placeholders expanded at runtime):
# VITE_CONTENT_BASE=https://cdn.velbee.com/visuals/{workspace}/{project}

# When manifest JSON also lives on R2 (optional until VelBEE API):
# VITE_MANIFEST_URL=https://cdn.velbee.com/visuals/{workspace}/{project}/manifest.json

# VelBEE API manifest (later):
# VITE_MANIFEST_URL=https://api.velbee.com/v1/workspaces/{workspace}/visuals/projects/{project}/manifest

# Legacy: marketing site subpath only (velbee.com/visuals/)
# VITE_BASE_PATH=/visuals/
